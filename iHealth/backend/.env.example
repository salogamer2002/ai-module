# ==============================================
# ARIA Voice Agent — Environment Configuration
# ==============================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env

# Primary LLM: Fireworks AI (Kimi K2 — Most Intelligent Model)
FIREWORKS_API_KEY=fw_your_fireworks_api_key_here

# Backup LLM: Groq (Llama 3.3 70B — Fastest Fallback)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Text-to-Speech (TTS) Voice Gender Configuration ("female" or "male")
# Setting this to "female" or "male" keeps both ElevenLabs and Cartesia voices matched.
TTS_GENDER=female

# ElevenLabs Conversational AI (Voice Agent — Primary TTS)
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=agent_your_agent_id_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Cartesia AI (Secondary TTS — 20K credits/month free)
CARTESIA_API_KEY=sk_car_your_cartesia_api_key_here

# API Authentication Key (used by frontend to call backend)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHATBOT_API_KEY=your_generated_api_key_here

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Server Port
PORT=3001

# Node Environment
NODE_ENV=development

# Azure OpenAI Credentials (Optional — for future enterprise embeddings)
AZURE_OPENAI_API_KEY="your-azure-openai-key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-02-01"
AZURE_OPENAI_CHAT_DEPLOYMENT="your-chat-model-deployment-name"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="your-embedding-deployment-name"

# Azure AI Search Credentials (Optional)
AZURE_SEARCH_SERVICE_ENDPOINT="https://your-search-service.search.windows.net"
AZURE_SEARCH_API_KEY="your-azure-search-admin-key"
AZURE_SEARCH_INDEX_NAME="ihealth-knowledge-index"
